# Se crean dos vectores en R^3, Xs y Ys respectivamente
Xs <- c(-1, 1, 2)
Ys <- c(1, 2, -1)
# Se crea una tabla de coordenadas
coords <- cbind(Xs, Ys)
print(coords)
# Se crean dos vectores en R^3, Xs y Ys respectivamente
Xs <- c(-1, 1, 2)
Ys <- c(1, 2, -1)
# Se crea una tabla de coordenadas
coords <- cbind(Xs, Ys)
print(coords)
# Se convierte o se crea a objeto Multipoint
MPt <- st_multipoint(coords)
plot(MPt, axes = TRUE)
class(MPt)
class(MPt)
class(MPt)
print(MPt)
class(MPt)
print(MPt)
