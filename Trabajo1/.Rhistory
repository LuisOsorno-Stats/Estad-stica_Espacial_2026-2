# Desviación estándar de los pixeles
cellStats(r1,"sd")
# Suma
sum1 <- r1 + 2
print(as.matrix(sum1))
# Sumar dos rasters
sum2 <- r1 + 2*r2
print(as.matrix(sum2))
# Aplicar la función f(x,y,z) a tres raster
sum3 <- overlay(r1, r2, sum1, fun=function(x, y, z){ x + 2*y -z})
print(as.matrix(sum3))
# Operaciones tipo SIG
# Mosaico (merge) y recorte (crop)
# Extent de r1 (xmin, xmin, ymin, ymax)
extent(r1)
# Creamos una tercera matriz de manera aleatoria
set.seed(12345)
m3 <- matrix(rpois(20, 6),ncol=4,nrow=5,byrow=TRUE)
print(m3)
# Se transforma en un objeto raster
r3 <- raster(m3)
# extent(xmin, xmax, ymin, ymax) ubicándolos al sur
extent(r3) <- extent(c(0,4,-5,0))
# Creamos el mosaico
mosaico <- merge(r1,r3)
# Verificamos su extent
extent(mosaico)
# Miramos la unión de los rasters
print(as.matrix(mosaico))
# Recortemos el mosaico, definimos las coordenadas
extent_corte <- extent(c(2,4,-3,2))
# Recortamos de acuerdo a las coordenadas
corte <- crop(mosaico,extent_corte)
# Imprimimos los resultados
print(as.matrix(corte))
# Veamos el raster r1
print(as.matrix(r1))
# Apliquemos la reasignación al raster r1
r1[r1 > 5] <- 6
print(as.matrix(r1))
# Tabla de reclasificación (rangos)
m <- c(0, 6, 0, 6, 20, 1)
tabla_reclas <- matrix(m, ncol=3, byrow=TRUE)
# Se muestra la tabla de reclasificación
print(tabla_reclas)
# Se implementa la tabla de reclasicación en el mosaico
reclas <- reclassify(mosaico, tabla_reclas)
# Se muestra la modificación
print(as.matrix(reclas))
# Vemos la matriz original antes de modificarla
print(as.matrix(r1))
# Sustitución de valores en celda
r1[r1==6] <- 0
print(as.matrix(r1))
# Tabla de reclasificación por valores
tab_subs <- data.frame(id=c(0,1,2,3,4),v=c(0,100,200,300,400))
# Se muestra la tabla de reemplazos
print(tab_subs)
# Se muestra la tabla original sin la sustitución
print(as.matrix(r1))
# Se aplica la sustitución
sub <- subs(r1, tab_subs)
# Se muestra la sustitución
print(as.matrix(sub))
# Agregación espacial en 2x2 tomando la media
agreg <- aggregate(mosaico, fact=2, fun="mean")
print(as.matrix(mosaico));print(as.matrix(agreg))
# Agregación espacial en 3x3 tomando la mediana
agreg2 <- aggregate(mosaico, fact=3, fun="median",na.rm = TRUE)
print(as.matrix(mosaico)); print(as.matrix(agreg2))
# Imagen de mismo tamaño que mosaico con menos filas
## Se crea el raster
m4 <- matrix(rep(1,20),ncol=4,nrow=5)
# Se convierte a tipo raster
r4 <- raster(m4)
## Se convierte en un obejto espacial tipo extent
extent(r4) <- extent(mosaico)
# Se aplican dos métodos de remuestreo
resv <- resample(mosaico,r4,method="ngb") # vecino más cercano
resb <- resample(mosaico,r4,method="bilinear") # bilinear
# Se observan los objetos remuestreados
print(as.matrix(resv)); print(as.matrix(resb))
# Se muestra el raster original
print(as.matrix(r1))
# Se aplica la función focal en la ventana 2x2 tomando la media
promedio <- focal(r1, w=matrix(1, 3, 3), fun="mean")
# Después de implemendar la operación focal se muestra el resultado
print(as.matrix(promedio))
# Veamos los mapas originales
print(as.matrix(r1))
print(as.matrix(r2))
zonal_sum <- zonal(r2,r1,"sum") # map de valores, mapa de zonas
print(zonal_sum)
# Veamos el raster r1
print(as.matrix(r1))
# Obtengamos todos los valores del raster
getValues(r1)
# Obtengamos la trecera fila
getValues(r1, row = 3)
# Se carga la libreria sf
# library(sf)
# Se carga el mapa de puntos
SFP <- st_read("DatosCap6/SFP.shp")
# Mapas para ver sobrelape
plot(st_geometry(SFP))
plot(mosaico, add = T)
plot(st_geometry(SFP), add = TRUE, col = "red", pch = 20)
# Extracción para los 3 puntos
extract(mosaico, SFP)
# La distancia que exploraremos será la euclidiana
## Definimos el raster
r <- raster(ncol=80,nrow=40)
projection(r) <- "+proj=utm +zone=15 +ellps=GRS80 +datum=NAD83 +units=m +no_defs"
values(r) <- NA
r[10000] <- 1
r[700] <- 2
plot(r)
dist <- distance(r,doEdge = F)
plot(dist)
# Con la siguiente instrucción se establece que:
## El archivo png se almacenará en DatosCap7
## El ancho es de 35 y la altura es de 25
## Las unidades del gráfico son centímetros
## Su resolución es de 350
## El fondo del gráfico es color oldlace
png(filename="DatosCap7/salida.png",width=35,height=25,
units="cm",res=350,bg="oldlace")
## Las margenes son: inferior 4.8, superior 4.5, izquierdo 2.1 y derecho de 2.7
par(mar=c(4.8,4.5,2.1,2.7))
## Se almacenarán 2 graficos en: una fila y dos columnas
par(mfrow=c(1,2))
# Se genera el gráfico de dispersión con números aleatorios
set.seed(12345)
x <- rpois(5, 4.5)
y <- rpois(5, 8)
z <- rpois(5, 12)
plot(x,y)
# Se pone texto en las coordenadas (6.5, 8)
text(6.5,8,"texto 1")
# Se realiza el segundo gráfico
plot(x,z)
# Se pone texto en las coordenadas (5, 10)
text(5, 10, "texto 2")
# Se finaliza el gráfico
dev.off()
# Crea una escala de 10 colores con terrain
colores <- terrain.colors(10, alpha = 0.5)
colores2 <- terrain.colors(10, alpha = 1) # con transparencia
# Con esta instrucción vemos los códigos de los colores
print(colores)
# Observemos la paleta de colores generada con terrain
par(mfrow=c(1,2))
pie(rep(1, 10), col = colores)
pie(rep(1, 10), col = colores2)
# Se carga la libreria RColorBrewer
# library(RColorBrewer)
# Se crean paletas de colores de los tres tipo,
# cada uno con 7 colores
secuencial <- brewer.pal(7,"Greens")
divergente <- brewer.pal(7,"BrBG")
cualitativa <- brewer.pal(7,"Accent")
# Elabora gráfico de pie con las 3 paletas
par(mfrow=c(1,3))
pie(rep(1, 7), col = secuencial, main="Secuencial")
pie(rep(1, 7), col = divergente, main="Divergente")
pie(rep(1, 7), col = cualitativa, main="Cualitativa")
# Se carga la libreria sf
# library(sf)
# Cargamos los datos
mx <- st_read("DatosCap7/mx_lcc.gpkg")
# Extraemos la variable densidad poblacional
var <- mx$dens
# Calcula su valor máximo y el mínimo
min(var); max(var)
# Ordenamos las densidades
sort(var)
# Graficamos un histograma
hist(var, breaks=100, main="",xlab="Densidad de población",
ylab="Número de estados")
# Se carga la libreria
# library(classInt)
# Implementamos la partición igual
classIntervals(var, n = 6, style = "equal")
# Implementamos la partición quantilica
intervalos <- classIntervals(var, n = 6, style = "quantile")
print(intervalos)
# Podemos ver los umbrales
umbrales <- intervalos$brks
print(umbrales)
# Creamos la paleta de grises
tonos <- gray.colors(6)
print(tonos)
# Buscamos los indices basados en el umbral
num_intervalo <- findInterval(var, umbrales,all.inside=TRUE)
print(num_intervalo)
# Finalmenet, asociamos los colores con el número del intervalo
codigos_color <- tonos[num_intervalo]
head(codigos_color)
# Mapa simple
plot(mx["dens"], breaks = "quantile")
# Se carga la librería RColorBrewer
# library(RColorBrewer)
# Generación de 7 colores en la escala verde a blanco
colores <- brewer.pal(7, "Greens")
plot(mx["dens"], breaks = "quantile", nbreaks = 7, pal = colores)
# El primer paso que vino es crear la paleta de colores
## Definiremos 7 colores o categorías
numclass <- 7
colores <- brewer.pal(numclass, "Greens")
# Basado en el método del cuantil, determinaremos los umbrales
var <- mx$dens
brks<-classIntervals(var, n=numclass, style="quantile")
brks <- brks$brks
print(brks)
# Realizaremos el match entre el color y su densidad
codigos_num <- findInterval(var, brks,all.inside=TRUE)
print(codigos_num)
# Luego el match entre los colores y el código numérico
codigos_color <- colores[codigos_num]
print(codigos_color)
# Se carga la librería sf
# library(sf)
# Se definen las margenes
par(mar=c(4.1,4.1,4.1,1.1))
# Se establece la imagen de salida, con propiedades como:
# tamaño, resolución, formato, unidades, entre otras
png(file="DatosCap7/mexico_densidad.png", height=16,
width=20, units="cm", res=300)
# Se dibuja el mapa, y se colorea de acuerdo a los establecidos
plot(mx["dens"], col=codigos_color, axes=T, main="")
# Se agrega el titulo
title(main="Densidad poblacional", cex.main=1.3)
# Se agrega la leyenda basado en los rangos establecidos
rangos <- levels(cut(mx$dens, breaks = round(brks, 0), include.lowest = TRUE))
rangos[1] <- paste("Menos de", round(brks[2], 0))
rangos[length(rangos)] <- paste("Más de", round(brks[length(brks)-1], 0))
legend("topright", inset=0.01, title=expression("Densidad (hb/km"^2*")") , legend=rangos, fill=colores, horiz=FALSE,
box.col = NA, cex = 1.1)
dev.off()
# Se importa la librería raster
# library(raster)
# Se define el tamaño del gráfico
extension <- extent(2000000,3000000,500000,1500000)
dem <- crop(raster("DatosCap7/DEM_Mx.tif"), extension)
# Creamos una escala de 7 colores
colores <- terrain.colors(7, alpha = 1)
# Se realiza el mapa
## Primero se establen los elementos de guardado
png(file="DatosCap7/dem-mx.png", height=20, width=20,
units="cm", res=400)
## Se grafica el raster
plot(dem, col=colores,
breaks=c(0, 500, 1000, 1500, 2000, 2500, 3000, 5300),
main = "Elevación")
# Se agregan aesthetics al gráfico
SpatialPolygonsRescale(layout.scale.bar(), offset= c(2100000,600000),
scale= 300000, fill=c("transparent", "black"),
plot.grid= F)
text(2100000,580000,"0")
text(2430000,580000,"300 km")
dev.off()
# Preparación de un sombreado
## Se establece la pendiente de elevación del raster
pend <- terrain(dem, opt = "slope")
## Se establece la orientación del raster
orient <- terrain(dem, opt = "aspect")
## Se calcula el sombreado basado en las capas de pendiente y
## Orientación
sombra <- hillShade(pend, orient, 40, 270)
# Plotea el sombreado y la elevación con transparencia
## Se establecen los elementos de guardado
png(file="DatosCap7/sombreado-mx.png", height=20, width=20,
units="cm", res=400)
## Se grafica el raster, bajo escala de grises como la primera capa
plot(sombra, col = grey(0:100/100), legend = FALSE, main = "Sombreado")
## Se agrega el relieve del raster
plot(dem, col = rainbow(25, alpha = 0.3), add = TRUE)
## Se continua agregando algunos aspectos del aesthetic
SpatialPolygonsRescale(layout.scale.bar(), offset= c(2100000,600000),
scale= 300000, fill=c("transparent", "black"),
plot.grid= F)
text(2100000,580000,"0")
text(2430000,580000,"300 km")
dev.off()
# Cargamos las librerias ggplot2 y ggspatial
# library(ggplot2)
# library(ggspatial)
# Graficamos el mapa
ggplot(data = mx) +
geom_sf()
ggplot(data = mx) +
geom_sf() +
xlab("Longitud") + ylab("Latitud") + # Agrega etiquetas a los ejes
ggtitle("República mexicana") + # Título principal
theme(plot.title = element_text(hjust = 0.5)) # Centra el título
# Agregando color al mapa
ggplot(data = mx) +
geom_sf(fill = "darkolivegreen3", colour = "black")
# Creamos un mapa con una escala continua de colores
ggplot(data = mx) +
geom_sf(aes(fill = dens), color="white") +
scale_fill_viridis_c(option = "magma", trans = "log") +
ggtitle("Densidad poblacional") +
theme(plot.title = element_text(hjust = 0.5)) +
labs(fill=expression("Densidad (hb/km"^2*")"))
# Definimos el número de intervalos y el método
intervalos <- classIntervals(mx$dens, n = 6, style = "quantile")
umbrales <- intervalos$brks
# Separamos o reclasificamos cada obseración en un intervalo
mx$cat <- cut(mx$dens, umbrales, include.lowest = TRUE)
# Finalmente se grafica
ggplot(data = mx) +
geom_sf(aes(fill = cat), color="grey") +
scale_fill_brewer(palette = "Greens") +
ggtitle("Densidad poblacional") +
theme(plot.title = element_text(hjust = 0.5)) +
labs(fill=expression("Densidad (hb/km"^2*")"))
# Sistema de referencia
ggplot(data = mx) +
geom_sf() +
coord_sf(crs = "epsg:5069") # Albers
# Aumentar el mapa
ggplot(data = mx) +
geom_sf(fill = "darkgrey" , colour = "black") +
coord_sf(xlim = c(2201757,3101494), ylim = c(634317,1296059),
expand=F)
# Agregando etiquetas
ggplot(data = mx) +
geom_sf(fill = "darkgrey" , colour = "black") +
geom_sf_label(aes(label = NOM_ENT)) +
coord_sf(xlim = c(2201757,3101494), ylim = c(634317,1296059),
expand=F)
# Se crea un mapa con leyenda y escala continua de colores
ggplot(data = mx) +
geom_sf(aes(fill = cat), color="black", lwd=0.3) +
scale_fill_brewer(palette = "OrRd") +
ggtitle("Densidad poblacional") +
theme(plot.title = element_text(hjust = 0.5)) +
labs(fill=expression("Densidad (hb/km"^2*")")) +
annotation_scale(location = "bl", width_hint = 0.5) +
annotation_north_arrow(location = "bl", which_north = "true",
pad_x = unit(9, "cm"), pad_y = unit(6, "cm"),
style = north_arrow_fancy_orienteering) +
annotate(geom="text", x=3500000, y=1500000, label="Golfo de México",
color="black", size = 3)
