library(RColorBrewer)
install.packages("RColorBrewer")
library(RColorBrewer)
# Se carga la libreria RColorBrewer
# library(RColorBrewer)
# Se crean paletas de colores de los tres tipo,
# cada uno con 10 colores
secuencial <- brewer.pal(10,"Greens")
divergente <- brewer.pal(10,"BrBG")
cualitativa <- brewer.pal(10,"Accent")
# Elabora gráfico de pie con las 3 paletas
par(mfrow=c(1,3))
pie(rep(1, 8), col = secuencial, main="Secuencial")
pie(rep(1, 8), col = divergente, main="Divergente")
pie(rep(1, 8), col = cualitativa, main="Cualitativa")
